---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import '../styles/notes.css';

export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => data.kind === 'essay');
  return essays.map((e) => ({ params: { slug: e.id }, props: { essay: e } }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
const d = essay.data;
const fmt = (x: Date) => x.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
const laneLabel = d.lane === 'event-horizon' ? 'event horizon' : d.lane;
const teal = d.lane === 'timeless' || d.lane === 'event-horizon';
---
<Base title={d.title} description={d.description} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={d.published.toISOString()} />
    {d.updated && <meta property="article:modified_time" content={d.updated.toISOString()} />}
  </Fragment>
  <div class="page-wrap">
    <article class="read">
      <div class="eyebrow">
        <span class:list={['num', { 'lane-teal': teal }]}>{d.number}</span>
        <span class:list={{ 'lane-teal': teal }}>{laneLabel}</span>
        <span class="date">{fmt(d.published)}{d.updated ? ` · revised ${fmt(d.updated)}` : ''}</span>
      </div>
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
      {d.speculative ? (
        <div class="builds-on speculative">
          <strong>position taken under uncertainty</strong>
          <span>dated {fmt(d.published)}; it may be wrong, and it says where.</span>
        </div>
      ) : (
        <div class="builds-on">
          <span>builds on</span>
          <a href="/assumptions">A0 &middot; the Assumptions</a>
          {d.number !== '01' && <a href="/objective-truth">01 &middot; Objective truth</a>}
          {d.number !== '01' && d.number !== '02' && <a href="/statistics">02 &middot; Statistics</a>}
        </div>
      )}
      <button class="notes-toggle" type="button" aria-pressed="true" hidden>precise notes: on</button>
      <div class="prose">
        <Content />
      </div>
      <div class="after">
        <a href="/essays">&larr; all essays</a>
        {d.substack && <a href={d.substack} class="mono">also on Substack</a>}
        <a href="/assumptions">the assumptions this rests on &rarr;</a>
      </div>
    </article>
  </div>
</Base>

<script>
  import { initSidenotes } from '../scripts/sidenotes.js';
  initSidenotes();
</script>
